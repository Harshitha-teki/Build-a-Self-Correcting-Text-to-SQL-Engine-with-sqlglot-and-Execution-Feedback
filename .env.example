# =============================================================================
# Build-a-Self-Correcting-Text-to-SQL-Engine :: environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# ---- LLM Configuration (hosted or local OpenAI-compatible endpoint) ----
# The pipeline falls back to a deterministic OFFLINE rule-based generator when
# no key is supplied (or the placeholder is left untouched), so the evaluation
# harness is reproducible without network access. Pin the exact model id used
# in any reported numbers.
OPENAI_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini
# Optional: point at a local OpenAI-compatible server (vLLM, Ollama, LM Studio).
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---- Database Configuration ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_messy

# Full DSN. docker-compose overrides DB_HOST to the service name `db`.
# When set, DATABASE_URL takes precedence over the individual DB_* fields.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_messy

# ---- API Configuration ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Repair loop configuration ----
# Hard cap on repair iterations (must be 3 per contract).
MAX_REPAIR_ATTEMPTS=3
# Rows above which a result is treated as a probable Cartesian product.
CARTESIAN_ROW_THRESHOLD=1000
ENABLE_SEMANTIC_CHECKS=true

# ---- Pinned evaluation identity (do not let these drift silently) ----
# Hash of data/eval_set.json used when the report was generated.
EVAL_SET_VERSION=1.0.0
